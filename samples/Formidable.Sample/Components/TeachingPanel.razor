@if (Demo is null)
{
    <aside class="teaching">
        <section>
            <h2>The rules</h2>
            @Rules
        </section>
        <section>
            <h2>Try it</h2>
            @TryIt
        </section>
        @if (CodeFiles is { Length: > 0 })
        {
            <details class="teaching__code">
                <summary>Show the code</summary>
                @foreach (var file in CodeFiles)
                {
                    <h3>@file</h3>
                    <pre><code>@Source.Read(file)</code></pre>
                }
            </details>
        }
    </aside>
}
else
{
    <div class="lesson">
        <aside class="teaching" aria-label="About this page">
            <section class="teaching__steps">
                <h2>Try it</h2>
                @TryIt
            </section>
            <section class="teaching__rules">
                <h2>The rules</h2>
                @Rules
            </section>
            @if (HowItWorks is not null)
            {
                <details class="teaching__more">
                    <summary><h2>How it works</h2></summary>
                    @HowItWorks
                </details>
            }
            @if (CodeFiles is { Length: > 0 })
            {
                <details class="teaching__code">
                    <summary>Show the code</summary>
                    @foreach (var file in CodeFiles)
                    {
                        <h3>@file</h3>
                        <pre><code>@Source.Read(file)</code></pre>
                    }
                </details>
            }
        </aside>
        <div class="lesson__demo">@Demo</div>
    </div>
}
