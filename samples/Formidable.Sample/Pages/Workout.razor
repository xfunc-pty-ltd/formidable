@page "/workout"

<PageTitle>Full workout</PageTitle>
<h1>Full workout</h1>
<p>This page puts most of Formidable's features into one event registration form. The steps tour it a section at a time, and each step links the page that teaches its feature on its own.</p>
@if (IsHostedDemo)
{
    <p><small>This hosted demo has no server behind it: an in-browser handler answers with the same validators and the same response shapes the real API would send, coupon rejection included.</small></p>
}

<TeachingPanel CodeFiles="@(new[] { "Workout.razor", "Workout.razor.cs", "EventRegistration.cs" })">
    <TryIt>
        @if (IsHostedDemo)
        {
            <p>No server to start on this hosted demo: the in-browser handler answers as soon as you click <strong>Submit registration</strong>, coupon rejection included.</p>
        }
        else
        {
            <p>Before the steps, start the API: <code>dotnet run --project samples/Formidable.Sample.Api</code>.</p>
        }
        <h3>Save draft: the draft rules</h3>
        <ol>
            <li>Click <strong>Save draft</strong> with nothing filled in.<div class="teaching__result"><span class="teaching__label">You see:</span> "Draft blocked: Dietary notes are required for catering" in the status line under the buttons.</div><div class="teaching__why"><span class="teaching__label">Why:</span> A draft save skips required rules, except the one on <strong>Dietary notes</strong>.</div><div class="teaching__page">More on <a href="profiles">Draft vs Submit</a>.</div></li>
        </ol>
        <h3>Contact email: an async check</h3>
        <ol start="2">
            <li>Type <code>taken@@example.com</code> into <strong>Contact email</strong>.<div class="teaching__result"><span class="teaching__label">You see:</span> a spinner in the box and "checking…" under it, then "That email is already registered".</div><div class="teaching__page">More on <a href="async">Async rules</a>.</div></li>
        </ol>
        <h3>Coupon code: the server's answer</h3>
        <ol start="3">
            <li>Replace <strong>Contact email</strong> with <code>ada@@example.com</code>, fill in <strong>Event name</strong>, <strong>Event date</strong>, <strong>Dietary notes</strong> and <strong>Venue region</strong>, type <code>BOGUS</code> into <strong>Coupon code</strong>, and click <strong>Submit registration</strong>.<div class="teaching__result"><span class="teaching__label">You see:</span> "Coupon code is not recognised" under <strong>Coupon code</strong>.</div><div class="teaching__why"><span class="teaching__label">Why:</span> Only the server knows the codes, and its rejection lands on the field it names.</div><div class="teaching__page">More on <a href="server">Server round-trip</a>.</div></li>
            <li>Change <strong>Coupon code</strong> to <code>WELCOME10</code> and click <strong>Submit registration</strong>.<div class="teaching__result"><span class="teaching__label">You see:</span> the coupon's message gone, and "Submitted" in the status line.</div><div class="teaching__page">More on <a href="server">Server round-trip</a>.</div></li>
        </ol>
        <h3>Catering: hidden fields</h3>
        <ol start="5">
            <li>Clear <strong>Dietary notes</strong> and press Tab, then untick <strong>Include catering</strong> and click <strong>Submit registration</strong>.<div class="teaching__result"><span class="teaching__label">You see:</span> "The form cannot be submitted because information that is not currently displayed is invalid." in the error summary.</div><div class="teaching__why"><span class="teaching__label">Why:</span> <strong>Dietary notes</strong>' rule still applies while hidden, and no error on screen explains the block.</div><div class="teaching__page">More on <a href="disclosure">Progressive disclosure</a> (which messages a form shows, and when).</div></li>
            <li>Tick <strong>Include catering</strong> and click <strong>Submit registration</strong>.<div class="teaching__result"><span class="teaching__label">You see:</span> "Dietary notes are required for catering" under the box and in the error summary, replacing the message about the form.</div><div class="teaching__page">More on <a href="disclosure">Progressive disclosure</a>.</div></li>
        </ol>
        <h3>Attendees: a warning</h3>
        <ol start="7">
            <li>Click <strong>Add attendee</strong> eleven times.<div class="teaching__result"><span class="teaching__label">You see:</span> the warning "More than 10 attendees needs approval" below the list, once the eleventh row appears.</div><div class="teaching__page">More on <a href="severity">Severity levels</a>.</div></li>
        </ol>
        <h3>Sessions: a long list</h3>
        <ol start="8">
            <li>Scroll to the end of the <strong>Sessions</strong> list, replace <code>0</code> with <code>900</code> in <strong>Session 150</strong>, and press Tab.<div class="teaching__result"><span class="teaching__label">You see:</span> "Seats must be a whole number between 0 and 500" under it.</div><div class="teaching__page">More on <a href="virtualized">Virtualize + KeepRegistered</a> (<code>KeepRegistered</code> is a setting that page explains).</div></li>
            <li>Scroll the list back to its top, then click that message in the error summary.<div class="teaching__result"><span class="teaching__label">You see:</span> the list scrolls back to <strong>Session 150</strong>, with focus in its box.</div><div class="teaching__why"><span class="teaching__label">Why:</span> The list renders only the rows near its view, so the page scrolls it first.</div><div class="teaching__page">More on <a href="virtualized">Virtualize + KeepRegistered</a>.</div></li>
        </ol>
        <h3>Ticket tier: a plain select</h3>
        <ol start="10">
            <li>Pick <strong>Choose…</strong>, the blank option, in <strong>Ticket tier</strong>.<div class="teaching__result"><span class="teaching__label">You see:</span> "Ticket tier is required" under <strong>Ticket tier</strong> and in the error summary.</div><div class="teaching__why"><span class="teaching__label">Why:</span> A <code>FormidableField</code> (a wrapper for one field's markup) connects this plain <code>&lt;select&gt;</code> to the form.</div><div class="teaching__page">More on <a href="foreign">Wrapping a foreign control</a>.</div></li>
        </ol>
        <h3>Venue region: Blazor's own input</h3>
        <ol start="11">
            <li>Clear <strong>Venue region</strong>, press Tab, then click "Venue region is required" in the error summary.<div class="teaching__result"><span class="teaching__label">You see:</span> that message under the box, and focus back in <strong>Venue region</strong>.</div><div class="teaching__why"><span class="teaching__label">Why:</span> The page gives Blazor's <code>InputText</code> the field's id, so the error summary can focus it.</div><div class="teaching__page">More on <a href="vanilla">Vanilla interop</a>.</div></li>
        </ol>
    </TryIt>
    <Rules>
        <ul>
            <li><strong>Contact email</strong>: a valid address not already registered, even in a draft; required to submit.</li>
            <li><strong>Event name</strong>: required to submit.</li>
            <li><strong>Event date</strong>: a real date, even in a draft; required to submit.</li>
            <li><strong>Early-bird deadline</strong>: optional; a real date on or before <strong>Event date</strong>, even in a draft.</li>
            <li><strong>Description</strong>: optional, with no rules.</li>
            <li><strong>Coupon code</strong>: optional; no rule in the browser, and the server accepts only codes it knows.</li>
            <li><strong>Catering headcount</strong>: optional; a whole number from 1 to 500 while catering is included, even in a draft.</li>
            <li><strong>Dietary notes</strong>: required, even in a draft and even while hidden.</li>
            <li><strong>Attendees</strong>: more than 10 draws a warning and none draws an info message; neither blocks.</li>
            <li><strong>Name</strong> (each attendee): required to submit.</li>
            <li><strong>Email</strong> (each attendee): optional; to submit, a valid address if filled in.</li>
            <li><strong>Seats</strong> (the box on each session): a whole number from 0 to 500, even in a draft.</li>
            <li><strong>Ticket tier</strong>: required to submit.</li>
            <li><strong>Venue region</strong>: required to submit.</li>
        </ul>
    </Rules>
    <HowItWorks>
        <h3>Draft and submit</h3>
        <p><strong>Submit registration</strong> runs the form's submit, which checks every rule, and posts the registration to the sample API when nothing blocks it. <strong>Save draft</strong> asks the validator directly for the <code>Draft</code> profile (a profile is a named selection of a validator's rules). It writes only the status line, so a draft save never changes a field's message.</p>
        <p>The validator splits its rules in two. The draft rules (the rules a draft save checks, which a submit checks too) hold most formats and ranges, the availability check (whether the address is already registered) and the two rules on the number of attendees. The submit rules hold the required rules and each attendee's email format.</p>
        <p><strong>Dietary notes</strong> is the one exception: its required rule is a draft rule, so a draft save answers about it as well.</p>
        <p>That split decides what a save or a submit checks, not when a message appears. Type <code>nope@@</code> into <strong>Contact email</strong> and clear <strong>Event name</strong>, and each shows its message with no submit. <strong>Save draft</strong> then names the address but not <strong>Event name</strong>, because the rule that requires <strong>Event name</strong> is not a draft rule.</p>
        <h3>When a message appears</h3>
        <p>As you edit, the form checks what a submit would, and shows messages only for the fields you have changed. Until a submit, a field you have not changed stays quiet however badly its rule fails. Type into it or clear it, and it answers with no submit.</p>
        <p>Every later edit anywhere on the form checks a changed field again, for as long as it is on the page. A field leaves the page when it stops being rendered, as a catering field does when you untick <strong>Include catering</strong>. A session row scrolled out of view is the exception: it still counts as on the page (see Sessions).</p>
        <p>After a submit, each edit also re-checks the whole form once you pause for 300 ms, so what the submit showed stays true.</p>
        <h3>Contact email</h3>
        <p><strong>Contact email</strong> sends every keystroke to the form (<code>UpdateOn="InputUpdateMode.OnInput"</code>), so each keystroke asks about a new address. The availability check waits 300 ms, a fixed delay standing in for a server call, and <code>taken@@example.com</code> is the one address already registered. While it waits, the box shows a spinner and "checking…" shows under it.</p>
        <p>The rule is written with <code>MustAsyncMemoized</code> and an <code>AsyncRuleMemo</code> (a store of answers) that keeps each answer for five minutes, so one address costs one check. Clear the box and type the same address again. The required and format messages come and go as before, but no "checking…" appears: every address you typed through already has an answer.</p>
        <p>Once you have changed <strong>Contact email</strong>, or after a submit, an edit to any other field asks about the address again too. It gets the kept answer at once, instead of waiting on a second call.</p>
        <p>The spinner shows only on the field you edited, however many fields a check answers. The availability check is the only rule here that takes any time. So changing the address shows the spinner, while an edit anywhere else is answered too quickly to show one, as long as the address's answer is kept.</p>
        <h3>Dates</h3>
        <p>Both date fields set <code>UpdateOn="InputUpdateMode.OnBlur"</code>. A native date box reports a change for each part you type (day, month or year). So each part sets the value, but the form hears about it only when you leave the field, once the date has settled.</p>
        <p>Each date must be a real date. The early-bird deadline must also fall on or before the event date, a rule that applies only once both are real dates.</p>
        <h3>Coupon and the server</h3>
        <p><strong>Coupon code</strong> has no rule in the browser: the server owns the list of codes. The page posts only after a submit finds nothing to block it, so the server's answer always arrives last.</p>
        <p>When the server rejects the registration, the page reads the reply. If it can, it hands the reply to the form's <code>ApplyServerIssues(...)</code>, which puts each issue on the field it names: here, <strong>Coupon code</strong>.</p>
        <p>Each rejection replaces the server's previous answer instead of adding to it, so a corrected resend never leaves an old coupon message behind. Changing <strong>Coupon code</strong> clears the server's message once you leave the box, before any resend.</p>
        <p>Before posting, the page calls the registration's <code>Normalize()</code>, the model's own cleanup. It trims <strong>Contact email</strong> and <strong>Description</strong>, turns each run of spaces inside <strong>Event name</strong> into one, and trims and upper-cases <strong>Coupon code</strong>. So <code>welcome10</code> and the server's <code>WELCOME10</code> are the same code, and the boxes show the cleaned values after the send. The <a href="normalize">Normalize</a> page shows the method on its own.</p>
        <h3>Catering</h3>
        <p>Catering starts ticked. Unticking it takes <strong>Catering headcount</strong> and <strong>Dietary notes</strong> off the page. The headcount's range rule carries a <code>When</code> condition (FluentValidation's condition on a rule) on the checkbox, so it applies only while catering is included.</p>
        <p>The rule that requires <strong>Dietary notes</strong> carries no condition, so it fails whether or not the box is on the page. For that field, the checkbox decides whether it shows, never whether its rule applies.</p>
        <p>At a submit, a field's error shows only while the field is on the page (the sessions' setting below is an exception). Once a submit has shown a field's error, under the field and in the error summary, the form keeps listing that field's errors, on the page or off, until a submit goes through or the form resets.</p>
        <p>When a blocked submit can show none of its errors under a field, the form adds a message about itself to the error summary. That entry belongs to the form: the blocked submit moves focus to the form, and a click on the entry does too. For an error no submit has shown, the form's entry takes the place of one pointing at nothing.</p>
        <p>At step 5, the note is off the page and is the only field failing. No error can show under a field, so the message about the form appears. The note gets no entry of its own either: the submit at step 4 went through, and a submit that goes through (or a reset) makes the form forget the errors earlier submits showed.</p>
        <p>An edit that puts no error on the page leaves that message standing. Type into <strong>Description</strong> while the form is blocked, and the box takes the green border that confirms a value would pass a submit, but the message stays. It lasts until an error on the page explains the block, and <strong>Description</strong> has no rule that could give one.</p>
        <p>A field that leaves the page stops counting as changed. So ticking the box brings the note back empty and quiet, even after you cleared it at step 5. The next submit shows the note's error under the box and in the error summary, and the message about the form gives way to it, as step 6 shows.</p>
        <p>Untick the box again after step 6, and the note and its message leave, but the error summary keeps the note's entry: a submit has shown its error. Another submit lists it again, with the message about the form beside it, since no error shows under a field. The note's rule never stopped failing; only whether its error could show changed.</p>
        <p>Step 5 went differently. Clearing the note and pressing Tab showed its message at once, under the box and in the error summary, as for any field you change. That message came from your edit, not a submit, so unticking took it away.</p>
        <p>Click the note's entry while the note is off the page, and focus moves to <strong>Include catering</strong>, the checkbox whose state is the reason the field is gone. The page hands the form and the error summary a <code>FocusFallback</code> callback, which runs when focus misses its field. For a hidden <strong>Dietary notes</strong> or <strong>Catering headcount</strong>, it focuses the checkbox instead of retrying a box that will not come back.</p>
        <h3>Attendees</h3>
        <p>Rows come and go with <strong>Add attendee</strong> and each row's <strong>Remove</strong>. A new row stays quiet until you change it or submit, though its empty <strong>Name</strong> already fails its rule. Type a name, press Tab, clear it and press Tab again, and "Attendee name is required" appears under it and in the error summary, with no submit.</p>
        <p>Nothing on the page or in the validator is set up for that: it is an ordinary required rule on a field you changed. Each row's <strong>Email</strong> answers the same way once you change it. Clicking a row's entry in the error summary moves focus to the box it names in that row.</p>
        <p>The list itself carries two rules. More than 10 attendees draws a warning, and none draws an info message, "You can add attendees now or after registering". Adding or removing a row changes the list, so each answers at once. Both are advisories (warnings and info messages), which never block: with eleven rows and the warning showing, a submit goes through once every required box is filled in.</p>
        <p>Remove every row and the warning gives way to the info message. Its entry in the error summary moves focus to the <strong>Attendees</strong> group, which has no box of its own.</p>
        <h3>Sessions</h3>
        <p>The 150 sessions sit in a virtualized list: Blazor's <code>Virtualize</code> renders only the rows in and near the view, so their boxes come and go as you scroll. The validator still checks every row in the model, rendered or not. A row's seats must be a whole number from 0 to 500, and that is a draft rule, so <strong>Save draft</strong> enforces it too.</p>
        <p>Changing a row's seats makes that row answer as you edit. Each box sets <code>KeepRegistered="true"</code>, which keeps a row counted as on the page after it scrolls out of the list's window and stops being rendered. Without it, the row would stop counting as changed once you scrolled away, and its entry would leave the error summary.</p>
        <p>The page also sets a <code>DisclosureOverride</code> (a <code>FormidableOptions</code> setting that can let an error show for a field nothing has rendered) for the sessions. So a submit lists every session's error, rows <code>Virtualize</code> has never rendered included, even if you never scrolled that far. The override changes only what shows. The validator checks every row either way, so it costs nothing.</p>
        <p>Clicking the entry of a row that is not rendered uses the summary's <code>FocusFallback</code>. A click can focus only a box that is rendered, so the callback scrolls the list to the row and gives <code>Virtualize</code> a moment to render it, and the summary tries once more. Change the row back to <code>0</code> and its message and entry clear.</p>
        <p>The page hands the same callback to the form's own <code>FocusFallback</code>. So when a blocked submit's first error sits on a row that is not rendered, the submit reaches it the same way with no click: the list scrolls itself, the row appears, and focus lands in its box.</p>
        <h3>Ticket tier</h3>
        <p><strong>Ticket tier</strong> is a foreign control (one Formidable has no input component for): a plain <code>&lt;select&gt;</code> the page renders itself.</p>
        <p>A <code>FormidableField</code> (the component that wraps one field's markup) hands it what a Formidable input gets for nothing: the element id, the class that shows the field's state and the aria attributes. It also hands it <code>NotifyChanged()</code>, the call that tells the form the value changed. So it takes the same borders and messages as the rest of the form, and focus from the error summary.</p>
        <p>Its required rule is a submit rule, and the form opens on <em>General admission</em>, so <strong>Ticket tier</strong> stays quiet until you pick the blank option. Picking is a change, so the message follows at once. A box with focus wears the blue focus border, whatever its state, so the red border shows once you leave <strong>Ticket tier</strong>. Click the entry and focus moves into <strong>Ticket tier</strong>.</p>
        <h3>Venue region</h3>
        <p><strong>Venue region</strong> is Blazor's own <code>InputText</code> and <code>ValidationMessage</code>, inside a Formidable form. Formidable writes each error into the form's <code>EditContext</code>, so the <code>ValidationMessage</code> shows "Venue region is required" as you edit and at a submit alike. Formidable also installs its own <code>FieldCssClassProvider</code> (Blazor's hook for the CSS classes an input wears), so the native box takes the same red and green borders as a Formidable input, with nothing set up per field.</p>
        <p>The page adds by hand what the shared <code>EditContext</code> cannot carry, one addition per concern. A <code>FormidableFieldAnchor</code> (a component that renders nothing) tells the form the field is on the page, so a submit shows its error. The input carries the field's element id, which is all a click in the error summary looks for. And the page writes three aria attributes, which a native input has no way to ask Formidable for.</p>
        <p><code>aria-required</code> stands whatever the box holds, because whether a field is required belongs to the rules. <code>aria-invalid</code> follows the field's errors. The page reads it from the form's validation state, and Blazor's <code>InputText</code> also writes it from the field's messages, with the same <code>true</code> or nothing.</p>
        <p>Formidable gives the element that lists a field's messages an id of its own, the field's messages id. The page puts that id on the <code>ValidationMessage</code>, and <code>aria-describedby</code> names it, but only while a message shows. A <code>ValidationMessage</code> renders nothing when there is none, and an id naming a missing element describes nothing.</p>
        <p>A Formidable input never has that problem: its <code>FormidableFieldMessage</code> (the component that shows one field's messages) stays on the page even when empty, so the id always names something.</p>
        <p>With <strong>Venue region</strong> cleared, inspect the box: it carries <code>aria-invalid="true"</code>, an <code>aria-describedby</code> naming the message below it, and the <code>aria-required="true"</code> it carried while it held a value. The page re-renders whenever the form's validation state changes, so the first two leave when you fill the box again. The borders and the message ride the shared <code>EditContext</code>, and the page renders the rest: the anchor, the id and the three aria attributes.</p>
        <h3>Required marks</h3>
        <p>The asterisks come from the validator. Each is a <code>FormidableRequiredIndicator</code> (the component that draws the mark), which asks what a submit demands and marks a field whose required rule has no condition. So <strong>Contact email</strong>, <strong>Event name</strong>, <strong>Event date</strong>, <strong>Dietary notes</strong>, <strong>Ticket tier</strong> and <strong>Venue region</strong> each carry one.</p>
        <p><strong>Early-bird deadline</strong>, <strong>Description</strong>, <strong>Coupon code</strong> and <strong>Catering headcount</strong> carry the same component and draw nothing: their rules check formats and ranges, never presence, and <strong>Description</strong> and <strong>Coupon code</strong> have no rule in the browser at all. Each attendee's <strong>Name</strong> is marked by the same rule that judges it, one mark per row; its <strong>Email</strong> has none.</p>
        <p>Each mark is <code>aria-hidden</code>, and its input carries <code>aria-required</code> instead, so a screen reader hears that the field is required rather than a star. A mark is not a message: a new attendee row shows its mark and no message.</p>
        <h3>The error summary</h3>
        <p>A submit with nothing filled in lists five errors and the attendees' info message. The form opens with a ticket tier chosen, catering ticked and every session's seats at 0, so only the boxes you type into are empty. Focus moves to <strong>Contact email</strong>, the first error on the page.</p>
        <p>Every entry in the error summary lands somewhere. An entry that names a box moves focus to it, native boxes included. The attendees' info message moves focus to the <strong>Attendees</strong> group, and the message about the form moves it to the form. Clicked with the mouse, a group or the form scrolls into view and takes focus quietly. Reached from the keyboard, it also shows an accent outline.</p>
    </HowItWorks>
    <Demo>
        <FormidableForm @ref="_form" Model="_registration" Options="_options" OnValidSubmit="SendToServer" OnInvalidSubmit="HandleBlocked" FocusFallback="RecoverMissedFocusAsync">
            <div class="summary-slot">
                <FormidableSummary FocusFallback="RecoverMissedFocusAsync" />
            </div>

            <fieldset>
                <legend>Registration details</legend>

                <FormidableField For="() => _registration.ContactEmail" Context="field">
                    <div class="field">
                        <label>Contact email <FormidableRequiredIndicator For="() => _registration.ContactEmail" /> <FormidableInputText @bind-Value="_registration.ContactEmail" UpdateOn="InputUpdateMode.OnInput" /></label>
                        <em role="status">@(field.State.IsValidating ? "checking…" : null)</em>
                    </div>
                    <FormidableFieldMessage For="() => _registration.ContactEmail" />
                </FormidableField>

                <div class="field"><label>Event name <FormidableRequiredIndicator For="() => _registration.EventName" /> <FormidableInputText @bind-Value="_registration.EventName" /></label>
                    <FormidableFieldMessage For="() => _registration.EventName" /></div>
                <div class="field"><label>Event date <FormidableRequiredIndicator For="() => _registration.EventDate" /> <FormidableInputText type="date" @bind-Value="_registration.EventDate" UpdateOn="InputUpdateMode.OnBlur" /></label>
                    <FormidableFieldMessage For="() => _registration.EventDate" /></div>
                <div class="field"><label>Early-bird deadline <FormidableRequiredIndicator For="() => _registration.EarlyBirdDeadline" /> <FormidableInputText type="date" @bind-Value="_registration.EarlyBirdDeadline" UpdateOn="InputUpdateMode.OnBlur" /></label>
                    <FormidableFieldMessage For="() => _registration.EarlyBirdDeadline" /></div>

                <div class="field"><label>Description <FormidableRequiredIndicator For="() => _registration.Description" /> <FormidableInputText @bind-Value="_registration.Description" /></label>
                    <FormidableFieldMessage For="() => _registration.Description" /></div>
                <div class="field"><label>Coupon code <FormidableRequiredIndicator For="() => _registration.CouponCode" /> <FormidableInputText @bind-Value="_registration.CouponCode" /></label>
                    <FormidableFieldMessage For="() => _registration.CouponCode" /></div>
            </fieldset>

            <fieldset>
                <legend>Catering</legend>

                <FormidableField For="() => _registration.IncludeCatering" Context="field">
                    <label><input type="checkbox" id="@field.ElementId" @ref="_includeCateringInput"
                                  checked="@_registration.IncludeCatering"
                                  @onchange="args => ToggleCatering(args, field)" /> Include catering</label>
                </FormidableField>

                <p><small>Unticking hides both catering fields. <strong>Dietary notes</strong> stays required whether or not you can see it, so a hidden empty note still blocks a submit, and the error summary says why.</small></p>

                @if (_registration.IncludeCatering)
                {
                    <div class="field"><label>Catering headcount <FormidableRequiredIndicator For="() => _registration.CateringHeadcount" /> <FormidableInputText @bind-Value="_registration.CateringHeadcount" /></label>
                        <FormidableFieldMessage For="() => _registration.CateringHeadcount" /></div>
                    <div class="field"><label>Dietary notes <FormidableRequiredIndicator For="() => _registration.DietaryNotes" /> <FormidableInputText @bind-Value="_registration.DietaryNotes" /></label>
                        <FormidableFieldMessage For="() => _registration.DietaryNotes" /></div>
                }
            </fieldset>

            <FormidableField For="() => _registration.Attendees" Context="field">
                <fieldset id="@field.ElementId" tabindex="-1">
                    <legend>Attendees</legend>

                    <ul class="member-list">
                        @foreach (var attendee in _registration.Attendees)
                        {
                            <li class="field" @key="attendee">
                                <label>Name <FormidableRequiredIndicator For="() => attendee.Name" /> <FormidableInputText @bind-Value="attendee.Name" /></label>
                                <FormidableFieldMessage For="() => attendee.Name" />
                                <label>Email <FormidableRequiredIndicator For="() => attendee.Email" /> <FormidableInputText @bind-Value="attendee.Email" /></label>
                                <FormidableFieldMessage For="() => attendee.Email" />
                                <div class="actions">
                                    <button type="button" @onclick="() => field.RemoveItem(_registration.Attendees, attendee)">Remove</button>
                                </div>
                            </li>
                        }
                    </ul>

                    <FormidableCollectionMessage For="() => _registration.Attendees" />

                    <div class="actions">
                        <button type="button" @onclick="() => field.AddItem(_registration.Attendees, new Attendee())">Add attendee</button>
                    </div>
                </fieldset>
            </FormidableField>

            <fieldset>
                <legend>Sessions</legend>

                <p><small>150 sessions in a virtualized list: only the rows near the scroll position are rendered, so their boxes come and go as you scroll. A row's errors still reach the error summary while it is out of view.</small></p>

                <div class="scroll-panel">
                    <Virtualize Items="_registration.Sessions" ItemSize="SessionRowHeight" Context="session">
                        <div class="field" @key="session">
                            <label>@session.Title
                                <FormidableInputText @bind-Value="session.Seats" KeepRegistered="true" />
                            </label>
                            <FormidableFieldMessage For="() => session.Seats" />
                        </div>
                    </Virtualize>
                </div>
            </fieldset>

            <fieldset>
                <legend>Ticket and venue</legend>

                <FormidableField For="() => _registration.TicketTier" Context="field">
                    <div class="field">
                        <label for="@field.ElementId">Ticket tier (foreign select) <FormidableRequiredIndicator For="() => _registration.TicketTier" /></label>
                        <select @attributes="field.InputAttributes"
                                value="@_registration.TicketTier" @onchange="args => ChangeTicketTier(args, field)">
                            <option value="">Choose…</option>
                            <option>General admission</option>
                            <option>VIP</option>
                            <option>Speaker</option>
                        </select>
                    </div>
                    <FormidableFieldMessage For="() => _registration.TicketTier" />
                </FormidableField>

                <div class="field"><label>Venue region (native InputText) <FormidableRequiredIndicator For="() => _registration.VenueRegion" /> <InputText @bind-Value="_registration.VenueRegion" id="@VenueRegionId" aria-invalid="@VenueRegionAriaInvalid" aria-describedby="@VenueRegionAriaDescribedBy" aria-required="@VenueRegionAriaRequired" /></label>
                    <ValidationMessage For="() => _registration.VenueRegion" id="@VenueRegionMessagesId" />
                    <FormidableFieldAnchor For="() => _registration.VenueRegion" /></div>
            </fieldset>

            <div class="actions">
                <button type="button" @onclick="SaveDraft">Save draft</button>
                <button type="submit" class="primary">Submit registration</button>
            </div>
        </FormidableForm>

        <p role="status">@_status</p>
    </Demo>
</TeachingPanel>
