@page "/server"
@inject HttpClient Http

<PageTitle>Server round-trip</PageTitle>
<h1>Server round-trip</h1>
<p>This form deliberately skips client-side submit validation — press Send and watch the server's 400 land on the exact fields. Run the Api first: <code>dotnet run --project samples/Formidable.Sample.Api</code>. Press "Send to server" rather than Enter — Enter triggers the browser's implicit form submission, which runs the client-side submit pipeline this page deliberately skips.</p>

<FormidableForm @ref="_form" Model="_order">
    <FormSummary />

    <p><label>Description <FormidableInputText For="() => _order.Description" @bind-Value="_order.Description" /></label>
        <FieldMessage For="() => _order.Description" /></p>

    @foreach (var line in _order.Lines)
    {
        <p @key="line"><label>SKU <FormidableInputText For="() => line.Sku" @bind-Value="line.Sku" /></label>
            <FieldMessage For="() => line.Sku" /></p>
    }
    <button type="button" @onclick="() => _order.Lines.Add(new OrderLine())">Add line</button>

    <button type="button" @onclick="Send">Send to server</button>
</FormidableForm>

@if (_serverWarnings.Count > 0)
{
    <h2>Server warnings (non-blocking)</h2>
    <ul>
        @foreach (var warning in _serverWarnings)
        {
            <li>@warning</li>
        }
    </ul>
}
<p role="status">@_status</p>

@code {
    private readonly RoundTripOrder _order = new() { Lines = [new OrderLine()] };
    private FormidableForm<RoundTripOrder>? _form;
    private readonly List<string> _serverWarnings = [];
    private string _status = string.Empty;

    private async Task Send()
    {
        _serverWarnings.Clear();
        var response = await Http.PostAsJsonAsync("/api/orders/", _order);

        if (response.IsSuccessStatusCode)
        {
            _status = "Server accepted the order.";
            return;
        }

        var problem = await response.Content.ReadFromJsonAsync<FormidableValidationProblem>();
        var issues = problem!.ToIssues();

        // The engine applies error-severity issues to fields; non-error issues are the
        // page's to present (a 400's warnings ride alongside its errors by contract).
        // Each call replaces the previous server verdict — pressing Send again with new
        // input swaps the old server errors for the new ones, rather than accumulating
        // them, so a corrected resubmission cannot leave stale errors behind.
        _form!.Engine!.ApplyServerIssues(issues);
        _serverWarnings.AddRange(issues
            .Where(i => i.Severity != ValidationSeverity.Error)
            .Select(i => i.Message));
        _status = "Server rejected the order — its errors are now inline.";
    }
}
