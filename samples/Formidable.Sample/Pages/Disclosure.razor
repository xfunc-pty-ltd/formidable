@page "/disclosure"

<PageTitle>Progressive disclosure</PageTitle>
<h1>Progressive disclosure</h1>
<p>Two different disclosure mechanisms live on this page. The traveler details section below is collapsed by pure UI state while its rule is unconditional: submit before expanding it and the error is suppressed — logged to the diagnostic below rather than shown inline — until the field is actually rendered. The accommodation cascade further down instead pairs each rule's <code>When</code> with the same condition that reveals its field, so its rules never produce a suppressed issue in the first place; that is the pattern for ordinary data-dependent sections.</p>

<TeachingPanel CodeFiles="@(new[] { "TravelRequest.cs", "Disclosure.razor", "Disclosure.razor.cs" })">
    <Rules>
        <ul>
            <li><strong>Destination</strong>, <strong>Traveler name</strong>, and the <strong>accommodation question</strong> — required, validated live.</li>
            <li><strong>Accommodation type</strong> — required only when you answered Yes; <strong>Special requirements</strong> — required only for Accessible. Their <code>When()</code> conditions mirror what the UI reveals.</li>
        </ul>
    </Rules>
    <TryIt>
        <ol>
            <li>Click <em>Show traveler details</em>, type into Traveler name, leave the field, clear it, leave again — the required message appears live because you acted on the field.</li>
            <li>Hide traveler details and submit — that error is suppressed into the diagnostic list below instead of appearing inline. A collapsed section cannot show a message.</li>
            <li>Show the details and submit again — the error is now inline and in the summary.</li>
            <li>Answer Yes, pick Accessible — watch the conditional cascade reveal rules only as their fields appear.</li>
            <li>Complete everything and submit — the status line confirms.</li>
        </ol>
        <p><small>Use the Submit button rather than pressing Enter — the browser's implicit submission bypasses this page's per-submit list clearing.</small></p>
    </TryIt>
</TeachingPanel>

<FormidableForm Model="_request" Options="_options" OnValidSubmit="HandleValid"
                @ref="_form">
    <FormidableSummary />

    <div class="field"><label>Destination <FormidableInputText @bind-Value="_request.Destination" /></label>
        <FormidableFieldMessage For="() => _request.Destination" /></div>

    <p>
        <button type="button"
                @onclick="() => _showDetails = !_showDetails">
            @(_showDetails ? "Hide" : "Show") traveler details
        </button>
    </p>
    @if (_showDetails)
    {
        <div class="field">
            <label>Traveler name
                <FormidableInputText @bind-Value="_request.TravelerName" /></label>
            <FormidableFieldMessage For="() => _request.TravelerName" />
        </div>
    }

    <fieldset>
        <legend>Do you need accommodation?</legend>
        <FormidableField For="() => _request.NeedsAccommodation" Context="field">
            <label><input type="radio" name="needs" id="@field.ElementId"
                          aria-invalid="@(field.AriaInvalid ? "true" : null)"
                          aria-describedby="@field.AriaDescribedBy"
                          checked="@(_request.NeedsAccommodation == true)"
                          @onchange="() => SetNeeds(true, field)" /> Yes</label>
            <label><input type="radio" name="needs"
                          checked="@(_request.NeedsAccommodation == false)"
                          @onchange="() => SetNeeds(false, field)" /> No</label>
        </FormidableField>
        <FormidableFieldMessage For="() => _request.NeedsAccommodation" />
    </fieldset>

    @if (_request.NeedsAccommodation == true)
    {
        <fieldset>
            <legend>Accommodation</legend>
            <FormidableField For="() => _request.AccommodationType" Context="field">
                <label>Type
                    <select id="@field.ElementId" class="@field.CssClass"
                            aria-invalid="@(field.AriaInvalid ? "true" : null)"
                            aria-describedby="@field.AriaDescribedBy"
                            value="@_request.AccommodationType"
                            @onchange="args => OnTypeChanged(args, field)">
                        <option value="">Choose…</option>
                        <option>Hotel</option>
                        <option>Serviced apartment</option>
                        <option>Accessible</option>
                    </select>
                </label>
            </FormidableField>
            <FormidableFieldMessage For="() => _request.AccommodationType" />

            @if (_request.AccommodationType == "Accessible")
            {
                <div class="field">
                    <label>Special requirements
                        <FormidableInputText @bind-Value="_request.SpecialRequirements" /></label>
                    <FormidableFieldMessage For="() => _request.SpecialRequirements" />
                </div>
            }
        </fieldset>
    }

    <div class="actions"><button type="button" class="primary" @onclick="Submit">Submit</button></div>
</FormidableForm>

<p role="status">@_status</p>

<h2>Suppressed-issue diagnostic</h2>
<p><small>Shows the issues the most recent submit suppressed — a fully disclosed submit leaves it empty.</small></p>
<ul>
    @foreach (var message in _suppressed)
    {
        <li>@message</li>
    }
</ul>
