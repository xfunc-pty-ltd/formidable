<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>ASP.NET Core validation for Formidable on FluentValidation. A minimal-API endpoint filter and an MVC [Validate] attribute run a validation profile and answer an error with a 400 ValidationProblemDetails. Its paths are the ones the Blazor client applies back onto its fields. A Native AOT app validates its minimal APIs with the endpoint filter; [Validate] is for MVC, which Native AOT does not support.</Description>
        <PackageTags>aspnetcore;validation;fluentvalidation;problemdetails;blazor;minimal-api;mvc</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\Formidable\Formidable.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\FriendlyTypeName.cs" Link="Shared\FriendlyTypeName.cs" />
        <Compile Include="..\Shared\MissingFluentValidatorMessage.cs" Link="Shared\MissingFluentValidatorMessage.cs" />
        <Using Include="Formidable.Shared" />
    </ItemGroup>
</Project>
