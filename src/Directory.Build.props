<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Applies only to the three library projects under src/ (this file is not imported by
             samples/ or tests/) - opts each into partial-trim participation for consumers who
             trim (Blazor WASM's default, Native AOT). The two Blazor-side trim-analysis warnings
             this surfaced were already fixed by annotating FormidableInputBase<TValue> and
             FormidableInputSelect<TValue>'s TValue with DynamicallyAccessedMemberTypes.All; the
             one core warning (AddFormidable's reflection-based introspector) is already an
             existing, justified UnconditionalSuppressMessage. -->
        <IsTrimmable>true</IsTrimmable>
        <Authors>xfunc</Authors>
        <Copyright>Copyright (c) xfunc</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/xfunc-pty-ltd/formidable</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageProjectUrl>https://github.com/xfunc-pty-ltd/formidable</PackageProjectUrl>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
        <!-- SourceLink comes from the .NET SDK's own bundled Sdks (Microsoft.SourceLink.GitHub
             and Microsoft.Build.Tasks.Git ship inside the SDK), so no standalone package is
             referenced: the 8.0.0 package added nothing the SDK does not already provide and
             pulled a transitively vulnerable Microsoft.Build.Tasks.Git into every restore. -->
    </ItemGroup>
    <ItemGroup>
        <!-- The repo-root README uses raw HTML (hero picture, centered badges) that renders
             fine on GitHub but not on nuget.org's HTML-free markdown subset, so the package
             ships the dedicated HTML-free readme under this name instead. -->
        <None Include="$(MSBuildThisFileDirectory)..\docs\nuget-readme.md" Pack="true" PackagePath="README.md" />
        <None Include="$(MSBuildThisFileDirectory)..\docs\assets\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
