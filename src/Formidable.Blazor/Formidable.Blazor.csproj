<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <Description>Blazor validation engine for Formidable: EditContext integration, validation profiles, render-registration progressive disclosure, and row-stable collection error identity.</Description>
        <PackageTags>blazor;validation;fluentvalidation;forms;editform</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Formidable\Formidable.csproj" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\FriendlyTypeName.cs" Link="Shared\FriendlyTypeName.cs" />
        <Using Include="Formidable.Shared" />
    </ItemGroup>
    <ItemGroup>
        <!-- Lets the test project pin internal engine-only mechanics (e.g. FieldRegistry's
             ever-registered tracking) directly, rather than only through public surface. -->
        <InternalsVisibleTo Include="Formidable.Blazor.Tests" />
    </ItemGroup>
</Project>
